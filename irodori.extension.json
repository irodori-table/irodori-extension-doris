{
  "$schema": "https://irodori.dev/schemas/irodori.extension.schema.json",
  "manifestVersion": 1,
  "id": "irodori.doris",
  "name": "Doris Connector",
  "version": "0.1.0",
  "publisher": "irodori",
  "description": "Doris Connector contributes the Apache Doris database connector through the native connector ABI. The frontend speaks the MySQL wire protocol, so the connector talks to the FE query port and reads multi-catalog databases alongside the internal one.",
  "license": "MIT OR 0BSD",
  "repository": "https://github.com/irodori-table/irodori-extension-doris",
  "apiVersion": "0.1",
  "runtime": "native",
  "entry": "dist/native",
  "permissions": [
    "connections:read",
    "connections:write",
    "queries:run",
    "metadata:read",
    "native",
    "connectors"
  ],
  "contributes": {
    "connectors": [
      {
        "id": "doris.connector",
        "engine": "doris",
        "label": "Apache Doris",
        "aliases": [
          "doris",
          "Doris",
          "apache-doris"
        ],
        "defaultPort": 9030,
        "wire": "mysql",
        "module": "doris.driver",
        "features": [
          "metadata",
          "sql",
          "explain",
          "queryTemplates",
          "visualization"
        ],
        "connection": {
          "schemaVersion": 1,
          "inferEnvironmentFrom": [
            "name",
            "id",
            "host",
            "database",
            "url"
          ],
          "compatibility": {
            "addsRequiredProfileFields": false,
            "acceptsExistingProfiles": true
          },
          "defaults": {
            "engine": "doris",
            "wire": "mysql",
            "port": 9030,
            "readOnly": false
          },
          "endpoint": {
            "modes": [
              "hostPort",
              "connectionString"
            ],
            "defaultPort": 9030,
            "fields": [
              {
                "id": "host",
                "label": "Host",
                "type": "string",
                "profileField": "host",
                "required": true
              },
              {
                "id": "port",
                "label": "Port",
                "type": "number",
                "profileField": "port",
                "default": 9030
              },
              {
                "id": "database",
                "label": "Database",
                "type": "string",
                "profileField": "database"
              }
            ]
          },
          "profileFields": [
            {
              "id": "id",
              "label": "Connection ID",
              "type": "string",
              "profileField": "id",
              "required": true
            },
            {
              "id": "url",
              "label": "Connection URL or DSN",
              "type": "uri",
              "profileField": "url"
            },
            {
              "id": "host",
              "label": "Host",
              "type": "string",
              "profileField": "host",
              "required": true
            },
            {
              "id": "port",
              "label": "Port",
              "type": "number",
              "profileField": "port",
              "default": 9030
            },
            {
              "id": "user",
              "label": "User",
              "type": "string",
              "profileField": "user"
            },
            {
              "id": "database",
              "label": "Database",
              "type": "string",
              "profileField": "database"
            },
            {
              "id": "readOnly",
              "label": "Read-only connection",
              "type": "boolean",
              "profileField": "readOnly",
              "default": false
            },
            {
              "id": "options",
              "label": "Driver options",
              "type": "map",
              "profileField": "options"
            }
          ],
          "authMethods": [
            {
              "id": "none",
              "label": "No authentication",
              "kind": "none",
              "secretPurposes": [],
              "fields": []
            },
            {
              "id": "userPassword",
              "label": "User/password",
              "kind": "userPassword",
              "secretPurposes": [
                "password"
              ],
              "fields": [
                {
                  "id": "user",
                  "label": "User",
                  "type": "string",
                  "profileField": "user"
                },
                {
                  "id": "password",
                  "label": "Password",
                  "type": "secret",
                  "secretPurpose": "password",
                  "profileField": "password"
                }
              ]
            },
            {
              "id": "connectionString",
              "label": "Connection string / DSN",
              "kind": "connectionString",
              "secretPurposes": [
                "password"
              ],
              "fields": [
                {
                  "id": "url",
                  "label": "Connection URL or DSN",
                  "type": "uri",
                  "profileField": "url",
                  "required": true
                }
              ]
            }
          ],
          "secretPurposes": [
            "password"
          ],
          "tls": {
            "supported": true,
            "requiredByDefault": false,
            "modes": [
              "disable",
              "prefer",
              "require",
              "verifyCa"
            ],
            "fields": [
              {
                "id": "caCertificate",
                "label": "CA certificate",
                "type": "pem"
              }
            ]
          },
          "transports": [
            "direct",
            "sshTunnel",
            "socks5Proxy",
            "httpConnectProxy",
            "proxyChain"
          ],
          "optionNamespaces": [
            "profile.options",
            "driver",
            "tls",
            "network",
            "doris"
          ],
          "customDriverOptions": true
        },
        "experience": {
          "schemaVersion": 1,
          "domains": [
            "warehouse"
          ],
          "inspiredBy": [
            "Doris multi-catalog",
            "Iceberg table actions",
            "frontend and backend split"
          ],
          "resultViews": [
            "table",
            "worksheet",
            "queryProfile"
          ],
          "objectTypes": [
            "catalogs",
            "databases",
            "tables",
            "columns",
            "views",
            "materializedViews"
          ],
          "workflows": [
            {
              "id": "multi-catalog",
              "label": "Catalogs",
              "description": "List the catalogs the frontend has attached and switch between them.",
              "resultView": "table",
              "templateIds": [
                "doris-show-catalogs"
              ]
            },
            {
              "id": "iceberg-metadata",
              "label": "Iceberg metadata",
              "description": "Read snapshots and refs off an Iceberg table in an attached catalog.",
              "resultView": "table",
              "templateIds": [
                "doris-iceberg-snapshots"
              ]
            },
            {
              "id": "table-actions",
              "label": "Iceberg actions",
              "description": "Compact, expire snapshots, or roll back an Iceberg table.",
              "resultView": "table",
              "templateIds": [
                "doris-iceberg-actions"
              ]
            }
          ],
          "queryTemplates": [
            {
              "id": "doris-show-catalogs",
              "label": "Show catalogs",
              "language": "sql",
              "description": "List attached catalogs, then switch to one.",
              "insertText": "SHOW CATALOGS;\n\n-- SWITCH <catalog_name>;\n-- SHOW DATABASES;",
              "parameters": [],
              "resultView": "table"
            },
            {
              "id": "doris-iceberg-snapshots",
              "label": "Iceberg snapshots",
              "language": "sql",
              "description": "Read the snapshot log and refs of an Iceberg table.",
              "insertText": "SELECT committed_at, snapshot_id, parent_id, operation\nFROM <catalog>.<database>.<table>$snapshots\nORDER BY committed_at DESC\nLIMIT 20;\n\n-- SELECT name, type, snapshot_id FROM <catalog>.<database>.<table>$refs;",
              "parameters": [],
              "resultView": "table"
            },
            {
              "id": "doris-iceberg-actions",
              "label": "Iceberg actions",
              "language": "sql",
              "description": "Expire snapshots, rewrite data files, or roll back. These delete files; check retention first.",
              "insertText": "-- Expiry deletes data files the expired snapshots alone referenced.\n-- ALTER TABLE <catalog>.<database>.<table>\n-- EXECUTE expire_snapshots(\"older_than\" = \"2024-01-01T00:00:00\", \"retain_last\" = \"1\");\n\n-- ALTER TABLE <catalog>.<database>.<table>\n-- EXECUTE rewrite_data_files(\"target-file-size-bytes\" = \"536870912\");\n\n-- ALTER TABLE <catalog>.<database>.<table>\n-- EXECUTE rollback_to_snapshot(\"snapshot_id\" = \"98765\");",
              "parameters": [],
              "resultView": "table"
            }
          ],
          "inspectorHints": [
            {
              "id": "catalog-origin",
              "label": "Catalog origin",
              "description": "Show whether a database comes from the internal catalog or an attached external one."
            },
            {
              "id": "table-format",
              "label": "Table format",
              "description": "Surface the table format behind an external catalog table."
            }
          ]
        }
      }
    ]
  },
  "capabilities": {
    "nativeModules": [
      {
        "id": "doris.driver",
        "path": "dist/native",
        "platforms": [
          "windowsX64",
          "windowsArm64",
          "macosX64",
          "macosArm64",
          "linuxX64",
          "linuxArm64"
        ]
      }
    ]
  },
  "dev": {
    "watch": [
      "src",
      "connector.config.json",
      "irodori.extension.json"
    ]
  }
}
